{
  "name": "arkem-yapi-sistemleri",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "demo:local": "node scripts/start-local-demo.mjs",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/zoning-access.test.mjs tests/issue-lifecycle.test.mjs tests/delivery-readiness.test.mjs tests/project-graph-eccentricity.test.mjs tests/project-graph-zoning.test.mjs tests/project-storage-reconciliation.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "locales:audit": "node --experimental-strip-types scripts/audit-locales.mjs",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "types:cloudflare": "wrangler types worker-configuration.d.ts -c wrangler.types.jsonc",
    "typecheck": "npm run types:cloudflare && tsc --noEmit",
    "test:geo:e2e": "node tests/geo-browser-smoke.mjs",
    "test:project:e2e": "node tests/project-continuity-smoke.mjs",
    "test:g05": "node --experimental-strip-types --test tests/g05-integrity.test.mjs tests/structural-traceability.test.mjs tests/floor-plate-study.test.mjs tests/floor-coordination.test.mjs tests/linear-frame.test.mjs tests/floor-frame.test.mjs tests/frame-example.test.mjs tests/shell-source.test.mjs tests/shell-solver.test.mjs tests/shell-documents.test.mjs tests/project-shell-source.test.mjs tests/project-shell-calculation.test.mjs tests/project-shell-storage.test.mjs && node --experimental-strip-types scripts/export-shell-sources.mjs",
    "test:g05:e2e": "node scripts/run-g05-browser.mjs",
    "build:local": "vite build --config vite.local.config.mjs",
    "test:local:ui": "npm run build:local && node --experimental-strip-types --test tests/current-ui-smoke.mjs tests/bim-section-strategy.test.mjs tests/delivery-readiness.test.mjs tests/project-graph-zoning.test.mjs tests/project-storage-reconciliation.test.mjs tests/technical-export-review.test.mjs",
    "test:land-research": "node --experimental-strip-types --test tests/land-research.test.mjs",
    "test:land-research:e2e": "node --experimental-strip-types tests/land-research-smoke.mjs",
    "demo:land": "node scripts/start-local-demo.mjs --land-browser",
    "test:land-browser": "node --experimental-strip-types --test tests/land-browser.test.mjs tests/emlakjet-browser.test.mjs",
    "test:land-browser:e2e": "node --experimental-strip-types --test tests/land-browser-fixture.test.mjs tests/emlakjet-browser-fixture.test.mjs",
    "probe:zoning": "node --experimental-strip-types scripts/probe-zoning.mjs",
    "probe:land": "node --experimental-strip-types scripts/probe-land-browser.mjs",
    "test:zoning-source": "node --experimental-strip-types --test tests/kastamonu-zoning.test.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/leaflet": "^1.9.20",
    "@types/three": "^0.185.1",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.3.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.63.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Arkem Yapı Sistemleri"
}
